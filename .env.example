# Defaults for these live in config/application.yml. Setting either of these
# env vars overrides the corresponding value from that file (same precedence
# as Spring Boot's application.yml + environment variables).
POSTGRES_DSN=postgresql://flow_home:flow_home@localhost:5432/flow_home_auth
DASHBOARD_ORIGINS=http://localhost:8081,http://localhost:5173,http://127.0.0.1:8081,http://127.0.0.1:5173
